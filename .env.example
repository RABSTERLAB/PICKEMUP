# PICKEMUP environment — copy to .env (never commit .env)
# --- Core ---
PICKEMUP_ENV=dev
# Dev/test surfaces (synthetic campaign, mock connector, file importers, demo
# endpoint) are HIDDEN and API-rejected unless enabled. Production: keep 0.
PICKEMUP_DEV_TOOLS=0
# SQLite default (zero-infrastructure demo mode). Postgres example:
# DATABASE_URL=postgresql+psycopg://pickemup:secret@localhost:5432/pickemup
DATABASE_URL=sqlite:///./data/pickemup.db
PICKEMUP_SECRET_KEY=change…tion
# --- X connector (leave unset for offline/mock mode; app must work without it) ---
X_BEARER_TOKEN=
X_API…Read
# Cost governance (USD). Enforced per collection job and per day.
X_MAX_COST_PER_JOB_USD=2.00
X_MAX_COST_PER_DAY_USD=10.00
X_COST_PER_POST_READ_USD=0.005
X_COST_PER_USER_READ_USD=0.010
# --- Workers ---
PICKEMUP_WORKER_POLL_SECONDS=2
